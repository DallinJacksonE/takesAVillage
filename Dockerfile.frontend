FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY shared/package.json shared/tsconfig.json ./shared/
COPY service/package.json ./service/
COPY frontend/package.json frontend/tsconfig.json frontend/tsconfig.node.json frontend/vite.config.ts ./frontend/
RUN npm ci

COPY shared/src ./shared/src
COPY frontend/src ./frontend/src
COPY frontend/index.html ./frontend/index.html
COPY frontend/config.json ./frontend/config.json
RUN npm run build -w @takes-a-village/shared \
    && npm run build -w frontend

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY shared/package.json ./shared/
COPY service/package.json ./service/
COPY frontend/package.json ./frontend/
RUN npm ci --omit=dev

COPY --from=builder /app/frontend/dist ./frontend/dist
COPY frontend/server.js ./frontend/server.js
USER node
EXPOSE 4999
CMD ["node", "frontend/server.js"]